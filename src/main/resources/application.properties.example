spring.application.name=HATW_B

# Database Configuration
spring.datasource.url=jdbc:mysql://localhost:3306/nav?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
spring.datasource.username=root
spring.datasource.password=1234
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# MyBatis Configuration
mybatis.mapper-locations=classpath:mapper/*.xml
mybatis.type-aliases-package=com.koreait.hatw_b.dto
mybatis.configuration.map-underscore-to-camel-case=true

# File Upload Configuration
file.upload-dir=uploads
spring.web.resources.static-locations=file:uploads/
spring.servlet.multipart.max-request-size=20MB

# TMAP API Configuration
TMAP.APP.KEY=your_tmap_api_key_here
POI.URL=https://apis.openapi.sk.com/tmap/pois
PEDESTRIAN.URL=https://apis.openapi.sk.com/tmap/routes/pedestrian?version=1
TRANSIT.URL=https://apis.openapi.sk.com/transit/routes
TRANSIT.MOCK.FILE=data/transit_route_moke2.json

# OpenAI Configuration
openai.api.key=your_openai_api_key_here

# CoolSMS Configuration
coolsms.api-key=your_coolsms_api_key_here
coolsms.api-secret=your_coolsms_api_secret_here
coolsms.sender=010

# Google OAuth Configuration
google.oauth.client-id=your_google_client_id_here
google.oauth.client-secret=your_google_client_secret_here
google.oauth.redirect-uri=http://localhost:5173/google-callback
google.oauth.auth-url=https://accounts.google.com/o/oauth2/v2/auth
google.oauth.token-url=https://oauth2.googleapis.com/token
google.oauth.userinfo-url=https://www.googleapis.com/oauth2/v2/userinfo 